{
  "name": "sky-turbo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "pnpm --filter @sky-turbo/core build && pnpm --filter @sky-turbo/web build && pnpm --filter @sky-turbo/worker build",
    "dev": "pnpm --filter @sky-turbo/web dev",
    "dev:worker": "pnpm --filter @sky-turbo/worker dev",
    "lint": "pnpm -r lint",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "backfill:history": "tsx scripts/backfill-coflnet.ts",
    "backfill:ah-history": "tsx scripts/backfill-coflnet-ah.ts",
    "collect:ah": "tsx scripts/collect-ah-flips.ts",
    "test": "pnpm -r --if-present test && tsx --test scripts/coflnet-backfill-lib.test.ts scripts/coflnet-ah-history-lib.test.ts",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.scripts.json",
    "sync:shards": "node scripts/sync-skyshards.mjs",
    "sync:npc-shops": "node scripts/sync-npc-shops.mjs",
    "sync:craft-recipes": "tsx scripts/sync-craft-recipes.ts",
    "sync:flip-data": "pnpm sync:shards && pnpm sync:npc-shops && pnpm sync:craft-recipes && pnpm sync:item-icons",
    "sync:item-icons": "tsx scripts/sync-hypixel-item-icons.ts"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "dotenv": "17.4.2",
    "fflate": "0.8.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
