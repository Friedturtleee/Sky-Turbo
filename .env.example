# Web / Vercel
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_EDGE_API_URL=http://localhost:8787

# Protects Vercel ingestion and Worker D1 internal routes. Use the same value
# in Vercel and apps/worker/.dev.vars (or `wrangler secret put`).
INGEST_SECRET=replace-with-a-long-random-value
# Optional local-only alternative used by the backfill script. Keep the file
# inside the gitignored .secrets directory.
INGEST_SECRET_FILE=

# Market and historical data use the Worker's D1 binding. No storage API key,
# R2 account, credit card, or S3 credentials are required.

# SkyCofl Bazaar/AH historical backfill and exact AH NBT valuation.
# Public history currently works without a token. A Premium+ / custom-app token
# may be supplied for identification and IP unblock handling.
COFLNET_API_TOKEN=
COFLNET_CONTACT=your-email-or-discord
COFLNET_REQUESTS_PER_MINUTE=90
# Set true only after SkyCofl approves this app's storage/use of its API data.
# This also enables exact NBT valuation in `pnpm collect:ah` and the web fallback scanner.
COFLNET_USAGE_APPROVED=false
# If your project is non-commercial, you may request a free token from SkyCofl. If your project is commercial, please contact SkyCofl for a commercial license.

# Optional Auction House scan limits. Leave blank for the application defaults.
AH_SCAN_MAX_PAGES=
AH_BOOTSTRAP_MAX_PAGES=2
AH_CANDIDATE_LIMIT=
AH_RESULT_LIMIT=
